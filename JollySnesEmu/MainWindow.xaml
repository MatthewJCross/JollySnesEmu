<Window x:Class="JollySnesEmu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="clr-namespace:Jolly2DEngine.Rendering.DirectX;assembly=Jolly2DEngine"
        Title="JollySnesEmu - Super Nintendo Emulator"
        Width="900" Height="760"
        MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#101820"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172630" Padding="14">
            <DockPanel>
                <TextBlock Text="JollySnesEmu" Foreground="#E8F1F2"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="RomNameText" Text="No cartridge loaded"
                           Foreground="#9FB3BA" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="20" Background="#05090C"
                BorderBrush="#30434D" BorderThickness="1">
            <dx:DirectXControl x:Name="GameView" />
        </Border>

        <Border Grid.Row="2" Background="#172630" Padding="10">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Initialising graphics..."
                           Foreground="#9FB3BA" VerticalAlignment="Center" />
                <Button Content="Load ROM" Padding="16,7" Margin="4,0"
                        HorizontalAlignment="Right" Click="LoadRom_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
